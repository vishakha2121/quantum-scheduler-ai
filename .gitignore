CREATE TABLE qubits (
    id VARCHAR(10) PRIMARY KEY,       -- q1, q2, ...
    hardware_id INTEGER,
    coherence_time_us FLOAT,          -- microseconds
    gate_error_rate FLOAT,            -- e.g. 0.001
    readout_error FLOAT,
    status VARCHAR(20)                -- free, busy, error
